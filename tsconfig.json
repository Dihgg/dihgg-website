{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "coverage",
    "dist"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": [
        "src/*"
      ],
        "@styles/*": [
          "src/styles/*"
        ]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react",
  }
}
